# =============================================================================
# Variables de entorno raíz — copiar a .env y completar valores reales
# Este archivo SÍ se commitea. El .env NO se commitea.
# =============================================================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT — usar un valor largo y aleatorio en cualquier entorno real
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Puerto externo del API Gateway
GATEWAY_PORT=8000

# Tiempo de expiración del token (minutos). 480 = 8 horas
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SMTP — dejar vacío para modo desarrollo (imprime emails en consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@practicas.cl
