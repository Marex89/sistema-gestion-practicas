# =============================================================================
# Variables de entorno del frontend — copiar a .env
# =============================================================================

# false  -> consume el backend real a través del API Gateway
# true   -> usa mockApi.js (datos en memoria, sin backend)
VITE_USE_MOCK=false

# URL base del API Gateway. El gateway expone sus rutas en la raíz
# (/auth, /users, /academic, /internships, /evaluations, /documents,
# /notifications), por lo que NO debe incluir el sufijo /api.
VITE_API_URL=http://localhost:8000
